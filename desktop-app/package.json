{
  "name": "fair-tax-portal",
  "productName": "Fair Tax",
  "version": "1.0.0",
  "description": "Fair Tax Portal for Windows – CRM, Audit Desk, reminders and AI assistant",
  "author": "Fair Tax International FZC",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.fairtax.portal",
    "productName": "Fair Tax",
    "copyright": "Fair Tax International FZC",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "offline.html", "sound.html", "assets/**/*"],
    "extraResources": [{ "from": "speech-bin", "to": "speech", "filter": ["**/*"] }],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.png",
      "artifactName": "FairTaxPortal-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fair Tax",
      "runAfterFinish": true
    }
  }
}
