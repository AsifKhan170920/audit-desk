<Project Sdk="Microsoft.NET.Sdk">
  <!-- Small Windows speech-recognition helper for the Fair Tax desktop app.
       Prints JSON lines: started / partial / final / notice / error / end. Type "stop" or "abort" on stdin to finish. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>FairTaxSpeech</AssemblyName>
    <RootNamespace>FairTaxSpeech</RootNamespace>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>Fair Tax International FZC</Company>
    <Product>Fair Tax</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
  </ItemGroup>
</Project>
